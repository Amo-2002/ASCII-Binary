<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FUTURE 图像二进制高级解码器</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #f0f2f5; color: #333; margin: 0; padding: 20px; }
        .container { max-width: 1000px; margin: 0 auto; background: white; padding: 25px; border-radius: 10px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); }
        h2 { margin-top: 0; color: #2c3e50; border-bottom: 2px solid #3498db; padding-bottom: 10px; }
        
        .controls-panel { display: flex; flex-wrap: wrap; gap: 15px; margin-bottom: 20px; padding: 15px; background: #f8f9fa; border-radius: 8px; border: 1px solid #e9ecef; }
        .control-group { display: flex; flex-direction: column; gap: 5px; }
        
        button { padding: 8px 15px; background-color: #3498db; color: white; border: none; border-radius: 5px; cursor: pointer; transition: 0.2s; font-weight: bold; }
        button:hover { background-color: #2980b9; }
        button.danger { background-color: #e74c3c; }
        button.danger:hover { background-color: #c0392b; }
        
        .canvas-container { position: relative; width: 100%; overflow: auto; border: 2px dashed #bdc3c7; border-radius: 5px; background: #fff; min-height: 300px; display: flex; justify-content: center; align-items: center;}
        canvas { max-width: 100%; height: auto; cursor: crosshair; display: block; }
        
        .status { font-size: 14px; font-weight: bold; color: #e67e22; margin-top: 10px; }
        
        .result-panel { margin-top: 20px; display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
        .box { padding: 15px; background: #eef2f5; border-radius: 8px; border-left: 5px solid #3498db; }
        .box h3 { margin-top: 0; font-size: 16px; color: #2c3e50; }
        .binary-text { font-family: monospace; word-break: break-all; color: #d35400; line-height: 1.5; font-size: 16px; letter-spacing: 1px;}
        .ascii-text { font-size: 24px; font-weight: bold; color: #27ae60; word-break: break-all;}
        
        .instructions { font-size: 14px; color: #666; background: #fff3cd; padding: 10px; border-radius: 5px; border-left: 5px solid #ffc107; margin-bottom: 20px;}
    </style>
</head>
<body>

<div class="container">
    <h2>FUTURE 密码解码器 (交互版)</h2>
    
    <div class="instructions">
        <strong>工作流程：</strong><br>
        1. <strong>定标阶段：</strong>先上传那张带有 `1-88` 数字的图片。使用鼠标依次点击图上的 1 到 88 的圆圈中心，记录下 88 个坐标点。（点错可点“撤销”）<br>
        2. <strong>解码阶段：</strong>保持网页不刷新，直接上传<strong>需要解码的无数字图片</strong>。系统会自动根据刚才标定的点读取颜色，并实时解码。
    </div>

    <div class="controls-panel">
        <div class="control-group">
            <label><strong>1. 上传图片:</strong></label>
            <input type="file" id="imageInput" accept="image/*">
        </div>
        <div class="control-group">
            <label><strong>2. 坐标操作:</strong></label>
            <div>
                <button onclick="undoPoint()">撤销上一点</button>
                <button onclick="clearPoints()" class="danger">清空所有点</button>
            </div>
        </div>
        <div class="control-group" style="flex-grow: 1;">
            <label><strong>3. 颜色判定阈值 (解码不准时调节此滑块):</strong> <span id="thresholdVal">382</span></label>
            <input type="range" id="thresholdSlider" min="0" max="765" value="382" style="width: 100%;">
            <small style="color:#7f8c8d;">RGB总和小于该值判定为 1(图案)，大于判定为 0(背景)</small>
        </div>
    </div>

    <div class="status" id="statusText">当前已标定坐标: 0 / 88</div>

    <div class="canvas-container">
        <span id="placeholderText" style="position: absolute; color: #999;">请先上传图片...</span>
        <canvas id="canvas"></canvas>
    </div>

    <div class="result-panel">
        <div class="box">
            <h3>二进制序列 (自动按 8 位分组)</h3>
            <div class="binary-text" id="binaryOutput">等待完整 88 个坐标...</div>
        </div>
        <div class="box" style="border-left-color: #27ae60;">
            <h3>ASCII 解密结果</h3>
            <div class="ascii-text" id="asciiOutput">-</div>
        </div>
    </div>
</div>

<script>
    const canvas = document.getElementById('canvas');
    const ctx = canvas.getContext('2d');
    const imageInput = document.getElementById('imageInput');
    const thresholdSlider = document.getElementById('thresholdSlider');
    const thresholdVal = document.getElementById('thresholdVal');
    
    let img = null;
    let points = []; // 存储相对坐标 {rx, ry} (0.0 ~ 1.0)
    let threshold = 382; // 默认阈值 255*1.5

    // 监听图片上传
    imageInput.addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = function(event) {
            img = new Image();
            img.onload = function() {
                document.getElementById('placeholderText').style.display = 'none';
                canvas.width = img.width;
                canvas.height = img.height;
                render();
            }
            img.src = event.target.result;
        }
        reader.readAsDataURL(file);
    });

    // 监听画布点击（记录坐标）
    canvas.addEventListener('mousedown', function(e) {
        if (!img) return;
        if (points.length >= 88) {
            alert("88 个坐标点已标定完毕！请上传需要解码的图案进行解密。");
            return;
        }

        // 计算点击位置在画布上的真实像素坐标，并转化为比例
        const rect = canvas.getBoundingClientRect();
        const scaleX = canvas.width / rect.width;
        const scaleY = canvas.height / rect.height;
        
        const x = (e.clientX - rect.left) * scaleX;
        const y = (e.clientY - rect.top) * scaleY;
        
        points.push({ rx: x / canvas.width, ry: y / canvas.height });
        render();
    });

    // 监听阈值滑块
    thresholdSlider.addEventListener('input', function(e) {
        threshold = parseInt(e.target.value);
        thresholdVal.innerText = threshold;
        render(); // 实时重新渲染和解码
    });

    // 撤销功能
    function undoPoint() {
        if (points.length > 0) {
            points.pop();
            render();
        }
    }

    // 清空功能
    function clearPoints() {
        if(confirm("确定要清空所有已标定的坐标吗？")) {
            points = [];
            render();
        }
    }

    // 核心渲染与解码函数
    function render() {
        if (!img) return;
        
        // 1. 绘制底图
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        ctx.drawImage(img, 0, 0);

        document.getElementById('statusText').innerText = `当前已标定坐标: ${points.length} / 88`;

        let binaryStr = "";

        // 2. 遍历所有点：连线、画点、采样
        ctx.lineWidth = 1;
        ctx.strokeStyle = 'rgba(255, 255, 255, 0.5)';
        ctx.beginPath();

        points.forEach((p, idx) => {
            const px = Math.floor(p.rx * canvas.width);
            const py = Math.floor(p.ry * canvas.height);

            // 采样该点的颜色
            const pixelData = ctx.getImageData(px, py, 1, 1).data;
            const r = pixelData[0], g = pixelData[1], b = pixelData[2];
            const sumRGB = r + g + b;
            
            // 判断是 1 还是 0
            const bit = (sumRGB < threshold) ? "1" : "0";
            binaryStr += bit;

            // 连线
            if (idx === 0) ctx.moveTo(px, py);
            else ctx.lineTo(px, py);

            // 画圆点（判定为1画红色/深色，判定为0画蓝色/浅色）
            ctx.beginPath();
            ctx.arc(px, py, Math.max(3, canvas.width/300), 0, 2 * Math.PI);
            ctx.fillStyle = (bit === "1") ? "#e74c3c" : "#3498db"; 
            ctx.fill();
            ctx.strokeStyle = "#fff";
            ctx.stroke();

            // 画序号
            ctx.font = `${Math.max(12, canvas.width/80)}px Arial`;
            ctx.fillStyle = "black";
            ctx.fillText(idx + 1, px + 5, py - 5);
        });

        // 3. 更新解码结果面板
        if (points.length === 88) {
            // 每 8 位加一个空格展示
            const formattedBinary = binaryStr.match(/.{1,8}/g).join(' ');
            document.getElementById('binaryOutput').innerText = formattedBinary;
            
            // 转化为 ASCII
            let asciiStr = "";
            for (let i = 0; i < binaryStr.length; i += 8) {
                const byte = binaryStr.substring(i, i + 8);
                if (byte.length === 8) {
                    asciiStr += String.fromCharCode(parseInt(byte, 2));
                }
            }
            document.getElementById('asciiOutput').innerText = asciiStr;
            document.getElementById('statusText').innerText = "✅ 88个坐标采集完毕，已实时解码！(若发现乱码，请微调上方滑块)";
            document.getElementById('statusText').style.color = "#27ae60";
        } else {
            document.getElementById('binaryOutput').innerText = "等待点满 88 个坐标...";
            document.getElementById('asciiOutput').innerText = "-";
            document.getElementById('statusText').style.color = "#e67e22";
        }
    }
</script>

</body>
</html>
